generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

enum UserRole {
  ADMIN 
  RECRUITER 
  CANDIDATE 
  MENTOR
}

model User {
  id String @id

  email String @unique 

  username String? @unique 

  role UserRole 
  
  firstName String?
  lastName String?
  
  phone String? @unique 

  avatarFileId String?
  resumeFileId String?

  bio String?
  github String? 
  linkedin String?
  location String? 
  headline String? 

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt 

  // marketplace configuration belonging to this mentor 

  mentorProfile MentorProfile?
}

model MentorProfile {
  id String @id @default(cuid())

  mentorId String @unique // references the user who owns this mentor marketplace profile 

  // defines the user relation for Prisma 

  mentor User @relation(fields: [mentorId], references: [id], onDelete: Cascade)

  monthlyMentorshipAmount Int 

  mentorshipExpertise String[] @default([])

  mentorshipEnabled Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt 
}

model MentorRating {
  id String @id @default(cuid())

  mentorId String 

  candidateId String 

  rating Int 
  review String? 

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt 

  @@unique([mentorId, candidateId])
  @@index([mentorId])
  @@index([candidateId])
}